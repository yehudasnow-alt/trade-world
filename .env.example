# Copy to .env and fill in. Every key is optional: whatever is missing, that source simply stays off.
# Sign-up and setup steps for each one: README.md, section "חשבונות ומפתחות".

# --- SEC EDGAR (free, required for report cards) ---
# Your own name and email, as the SEC fair-access policy asks of automated clients.
SEC_USER_AGENT=
SEC_RPS=8

# --- Claude (report cards) ---
ANTHROPIC_API_KEY=
AI_MODEL_LIGHT=claude-haiku-5-5
AI_MODEL_CARD=claude-sonnet-5-5
AI_MODEL_REVIEW=claude-opus-5-5
# focus = deep cards for holdings + watchlist, light cards for everyone else; all = deep for every company
AI_DEEP_SCOPE=focus
AI_USE_BATCH=true
AI_MONTHLY_BUDGET_USD=30

# --- Prices: Alpaca free plan (15-minute delayed full market) ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=delayed_sip

# --- Earnings calendar and surprises: Finnhub free plan ---
FINNHUB_API_KEY=

# --- Optional: transcripts from FMP (paid). Without it, drop transcript files into data/transcripts/ ---
FMP_API_KEY=

# --- IBKR: portfolio via Flex (daily), live quotes via IB Gateway (optional) ---
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_LIVE=false
IBKR_HOST=127.0.0.1
# IB Gateway: 4001 live account, 4002 paper account
IBKR_PORT=4001
IBKR_CLIENT_ID=17
IBKR_MAX_LINES=90

# --- Alerts to Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Israel time; urgent alerts ignore quiet hours
QUIET_START=23:30
QUIET_END=07:00
BRIEF_TIME=08:00
LOCAL_TZ=Asia/Jerusalem

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Set this before exposing the server beyond your own computer. Open http://host:8000/?token=... once per device.
ACCESS_TOKEN=

# --- Backups: every night at 03:15 New York time into data/backups/; BACKUP_DIR adds a second copy (a cloud-synced folder) ---
BACKUP_DIR=
BACKUP_KEEP=7

# --- Trade calculator defaults ---
PORTFOLIO_SIZE_USD=100000
RISK_PER_TRADE_PCT=1.0
